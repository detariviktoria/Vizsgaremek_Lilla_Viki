<Window x:Class="VizsgaAdminWpf.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VizsgaRemek Admin" Height="550" Width="900"
        MinWidth="850" MinHeight="550"
        Loaded="AdminWindow_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal" Visibility="{Binding UserVM.IsNotLoggedIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Admin Bejelentkezés:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Felhasználó:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtLoginUser" Text="{Binding UserVM.LoginUsername, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <TextBlock Text="Jelszó:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="txtLoginPass" Width="120" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <Button x:Name="btnLogin" Content="Belépés" Click="btnLogin_Click" Background="#007BFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="lblLoginStatus" Text="Nincs bejelentkezve" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#DC3545" FontWeight="SemiBold"/>
                </StackPanel>
                
                <Grid Visibility="{Binding UserVM.IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#28A745" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bejelentkezve mint Admin" VerticalAlignment="Center" FontWeight="Bold" Foreground="#28A745" FontSize="14"/>
                    </StackPanel>
                    <Button x:Name="btnLogout" Grid.Column="1" Content="Kijelentkezés" Click="btnLogout_Click" Background="#DC3545" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>

        <TabControl x:Name="tabMain" Grid.Row="1" SelectionChanged="tabMain_SelectionChanged" Visibility="{Binding UserVM.IsLoggedIn, Converter={StaticResource BoolToVis}}" BorderThickness="0" Background="Transparent">
            
            <TabItem Header="Ajándékok" Padding="15,5">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ajándékok listája" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox x:Name="listBoxGifts" Grid.Row="1" 
                                 ItemsSource="{Binding GiftsVM.Gifts}" 
                                 SelectedItem="{Binding GiftsVM.SelectedGift}" 
                                 SelectionChanged="listBoxGifts_SelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 BorderBrush="#DEE2E6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F3F5" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0} Ft'}" Foreground="#495057" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="220" Margin="10,0,10,0">
                            <TextBlock Text="Műveletek" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button x:Name="btnDelete" Content="Kijelölt törlése" Background="#E83E8C" Foreground="White" Click="btnDelete_Click" Margin="0,0,0,15" FontWeight="Bold"/>
                            <Button x:Name="btnRefresh" Content="Lista frissítése" Click="btnRefresh_Click" Margin="0,0,0,20"/>

                            <TextBlock Text="Ajándék adatai" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Megnevezés"/>
                            <TextBox Text="{Binding GiftsVM.CurrentGift.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            
                            <TextBlock Text="Ár (Ft)"/>
                            <TextBox Text="{Binding GiftsVM.CurrentGift.Price, UpdateSourceTrigger=PropertyChanged}"/>
                            
                            <TextBlock Text="Leírás"/>
                            <TextBox Text="{Binding GiftsVM.CurrentGift.Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            
                            <TextBlock Text="Kategória"/>
                            <ComboBox SelectedValue="{Binding GiftsVM.CurrentGift.Category, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                <ComboBoxItem Content="tárgy"/>
                                <ComboBoxItem Content="élmény"/>
                            </ComboBox>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnAdd" Grid.Column="0" Content="Hozzáad" Click="btnAdd_Click" Background="#28A745" Foreground="White" FontWeight="Bold"/>
                                <Button x:Name="btnEdit" Grid.Column="1" Content="Módosít" Click="btnEdit_Click" Background="#FFC107" Foreground="Black" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Kép megtekintése" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1" Background="White" CornerRadius="5" Padding="5" MinHeight="200" MaxHeight="400">
                            <Image x:Name="imageGift" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="btnUploadImage" Grid.Row="2" VerticalAlignment="Top" Content="Új kép feltöltése..." Margin="0,15,0,0" Click="btnUploadImage_Click" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Felhasználók" Padding="15,5">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Felhasználók kezelése" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox x:Name="listBoxUsers" Grid.Row="1" 
                                 ItemsSource="{Binding UserVM.Users}" 
                                 SelectedItem="{Binding UserVM.SelectedUser}"
                                 HorizontalContentAlignment="Stretch"
                                 BorderBrush="#DEE2E6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F3F5" BorderThickness="0,0,0,1" Padding="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Email}" Foreground="#6C757D" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,0,0,0" MaxWidth="400" HorizontalAlignment="Left">
                            <TextBlock Text="Felhasználó szerkesztése" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Button x:Name="btnUserRefresh" Content="Lista frissítése" Click="btnUserRefresh_Click" Margin="0,0,0,20" HorizontalAlignment="Left" Width="150"/>

                            <TextBlock Text="Név" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding UserVM.CurrentUserName, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left"/>
                            
                            <TextBlock Text="E-mail cím" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding UserVM.CurrentUserEmail, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left"/>
                            
                            <TextBlock Text="Új jelszó (csak ha módosítani akarod)" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="txtUserPassword" Width="250" HorizontalAlignment="Left"/>

                            <Button x:Name="btnUserUpdate" Content="Adatok mentése" Background="#E83E8C" Foreground="White" Click="btnUserUpdate_Click" Margin="0,15,0,0" FontWeight="Bold" Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
