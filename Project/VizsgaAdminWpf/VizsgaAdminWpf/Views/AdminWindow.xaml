<Window x:Class="VizsgaAdminWpf.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VizsgaRemek Admin" Height="480" Width="820"
        Loaded="AdminWindow_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Login Section -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Visibility="{Binding UserVM.IsNotLoggedIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Admin Bejelentkezés:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBox x:Name="txtLoginUser" Text="{Binding UserVM.LoginUsername, UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <PasswordBox x:Name="txtLoginPass" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="btnLogin" Content="Belépés" Click="btnLogin_Click" Padding="10,2" Background="LightBlue"/>
                    <TextBlock x:Name="lblLoginStatus" Text="Nincs bejelentkezve" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Red"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Visibility="{Binding UserVM.IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Bejelentkezve mint Admin" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold" Foreground="Green"/>
                    <Button x:Name="btnLogout" Content="Kijelentkezés" Click="btnLogout_Click" Padding="10,2" Background="LightCoral"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="tabMain" Grid.Row="1" SelectionChanged="tabMain_SelectionChanged" Visibility="{Binding UserVM.IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <TabItem Header="Ajándékok">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ajándékok kezelése" FontSize="20" Margin="0,0,0,10"/>
                        <ListBox x:Name="listBoxGifts" Height="320" ItemsSource="{Binding GiftsVM.Gifts}" SelectedItem="{Binding GiftsVM.SelectedGift}" SelectionChanged="listBoxGifts_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding nev}" FontWeight="Bold"/>
                                        <TextBlock Text=" - "/>
                                        <TextBlock Text="{Binding ar}"/>
                                        <TextBlock Text=" Ft"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Top">
                        <Button x:Name="btnDelete" Content="Törlés" Width="120" Height="40" Background="HotPink" Foreground="White" Click="btnDelete_Click" Margin="0,0,0,5"/>
                        <Button x:Name="btnRefresh" Content="Frissítés" Width="120" Height="30" Click="btnRefresh_Click" Margin="0,0,0,15"/>

                        <TextBlock Text="Név"/>
                        <TextBox Text="{Binding GiftsVM.CurrentGift.nev, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,5"/>
                        <TextBlock Text="Ár"/>
                        <TextBox Text="{Binding GiftsVM.CurrentGift.ar, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,5"/>
                        <TextBlock Text="Leírás"/>
                        <TextBox Text="{Binding GiftsVM.CurrentGift.leiras, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,5"/>
                        <TextBlock Text="Kategória"/>
                        <TextBox Text="{Binding GiftsVM.CurrentGift.kategoria, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnAdd" Content="Hozzáad" Width="65" Height="30" Click="btnAdd_Click" Margin="0,0,5,0"/>
                            <Button x:Name="btnEdit" Content="Módosít" Width="65" Height="30" Click="btnEdit_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Kép" Margin="0,0,0,5"/>
                        <Border BorderBrush="Black" BorderThickness="1" Width="200" Height="200">
                            <Image x:Name="imageGift" Stretch="Uniform"/>
                        </Border>
                        <Button x:Name="btnUploadImage" Content="Kép feltöltése" Width="200" Height="30" Margin="0,10,0,0" Click="btnUploadImage_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Felhasználók">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Felhasználók kezelése" FontSize="20" Margin="0,0,0,10"/>
                        <ListBox x:Name="listBoxUsers" Height="320" ItemsSource="{Binding UserVM.Users}" SelectedItem="{Binding UserVM.SelectedUser}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding name}" FontWeight="Bold"/>
                                        <TextBlock Text=" – "/>
                                        <TextBlock Text="{Binding email}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Top">
                        <Button x:Name="btnUserRefresh" Content="Frissítés" Width="120" Height="30" Click="btnUserRefresh_Click" Margin="0,0,0,15"/>

                        <TextBlock Text="Név"/>
                        <TextBox Text="{Binding UserVM.CurrentUserName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,5"/>
                        <TextBlock Text="E-mail cím"/>
                        <TextBox Text="{Binding UserVM.CurrentUserEmail, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,0,5"/>
                        <TextBlock Text="Új jelszó (opcionális)"/>
                        <PasswordBox x:Name="txtUserPassword" Width="140" Margin="0,0,0,10"/>

                        <Button x:Name="btnUserUpdate" Content="Módosít" Width="120" Height="30" Background="HotPink" Foreground="White" Click="btnUserUpdate_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
