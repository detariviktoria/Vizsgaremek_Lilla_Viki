using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;
using System.Diagnostics;

namespace VizsgaAdminWpf
{
    public class ApiService
    {
        private static readonly CookieContainer cookieContainer = new CookieContainer();
        private static readonly HttpClientHandler handler = new HttpClientHandler
        {
            CookieContainer = cookieContainer,
            UseCookies = true,
            AllowAutoRedirect = true
        };

        private static readonly HttpClient client = new HttpClient(handler);
        private const string BaseUrl = "http://localhost:3000";

        static ApiService()
        {
            client.BaseAddress = new Uri(BaseUrl);
            client.Timeout = TimeSpan.FromSeconds(30);
            client.DefaultRequestHeaders.Accept.Clear();
            client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
            client.DefaultRequestHeaders.UserAgent.ParseAdd("VizsgaAdminWpf/1.0");
        }

        private readonly JsonSerializerOptions jsonOptions = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        private async Task<string> ReadResponseOrThrow(HttpResponseMessage response)
        {
            var content = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    using var doc = JsonDocument.Parse(content);
                    if (doc.RootElement.TryGetProperty("message", out var m))
                    {
                        throw new HttpRequestException(m.GetString());
                    }
                    if (doc.RootElement.TryGetProperty("error", out var e))
                    {
                        throw new HttpRequestException(e.GetString());
                    }
                }
                catch (JsonException) { }

                throw new HttpRequestException($"HTTP {(int)response.StatusCode} {response.ReasonPhrase}: {content}");
            }
            return content;
        }

        private async Task<T> GetJsonAsync<T>(string relativeUrl)
        {
            var response = await client.GetAsync(relativeUrl);
            var json = await ReadResponseOrThrow(response);
            return JsonSerializer.Deserialize<T>(json, jsonOptions);
        }

        private async Task<T> PostJsonAsync<T>(string relativeUrl, object payload)
        {
            var json = JsonSerializer.Serialize(payload, jsonOptions);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await client.PostAsync(relativeUrl, content);
            var respJson = await ReadResponseOrThrow(response);
            return JsonSerializer.Deserialize<T>(respJson, jsonOptions);
        }

        private async Task PostJsonNoResultAsync(string relativeUrl, object payload)
        {
            var json = JsonSerializer.Serialize(payload, jsonOptions);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await client.PostAsync(relativeUrl, content);
            await ReadResponseOrThrow(response);
        }

        private async Task<T> PutJsonAsync<T>(string relativeUrl, object payload)
        {
            var json = JsonSerializer.Serialize(payload, jsonOptions);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await client.PutAsync(relativeUrl, content);
            var respJson = await ReadResponseOrThrow(response);
            return JsonSerializer.Deserialize<T>(respJson, jsonOptions);
        }

        public async Task<List<string>> GetAlkalmak()
        {
            return await GetJsonAsync<List<string>>("/alkalmak");
        }

        public async Task<List<string>> GetStilusok()
        {
            return await GetJsonAsync<List<string>>("/stilusok");
        }

        public async Task<List<string>> GetCelcsoportok()
        {
            return await GetJsonAsync<List<string>>("/celcsoportok");
        }

        public async Task<List<AjandekDTO>> GetAjandekok()
        {
            return await GetJsonAsync<List<AjandekDTO>>("/ajandekok");
        }

        public async Task<List<AjandekDTO>> GetAjandekokByAlkalom(string alkalom)
        {
            var enc = Uri.EscapeDataString(alkalom);
            return await GetJsonAsync<List<AjandekDTO>>($"/ajandekok/alkalom/{enc}");
        }

        public async Task<List<AjandekDTO>> GetAjandekokByStilus(string stilus)
        {
            var enc = Uri.EscapeDataString(stilus);
            return await GetJsonAsync<List<AjandekDTO>>($"/ajandekok/stilus/{enc}");
        }

        public async Task<List<AjandekDTO>> GetAjandekokByCelcsoport(string celcsoport)
        {
            var enc = Uri.EscapeDataString(celcsoport);
            return await GetJsonAsync<List<AjandekDTO>>($"/ajandekok/celcsoport/{enc}");
        }

        public async Task CreateAjandek(AjandekDTO ajandek)
        {
            await PostJsonNoResultAsync("/ajandekok", ajandek);
        }

        public async Task UpdateAjandek(int id, AjandekDTO ajandek)
        {
            var json = JsonSerializer.Serialize(ajandek, jsonOptions);
            var content = new StringContent(json, Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"/ajandekok/{id}", content);
            await ReadResponseOrThrow(response);
        }

        public async Task DeleteAjandek(int id)
        {
            var response = await client.DeleteAsync($"/ajandekok/{id}");
            await ReadResponseOrThrow(response);
        }

        public async Task<string> UploadImage(string filePath)
        {
            using var content = new MultipartFormDataContent();
            using var fs = new FileStream(filePath, FileMode.Open, FileAccess.Read);
            var fileContent = new StreamContent(fs);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(fileContent, "image", Path.GetFileName(filePath));
            var response = await client.PostAsync("/upload", content);
            var json = await ReadResponseOrThrow(response);
            var dto = JsonSerializer.Deserialize<UploadResponse>(json, jsonOptions);
            return dto?.filename;
        }

        public async Task<LoginResponse> Login(string username, string password)
        {
            var payload = new { username, password };
            var result = await PostJsonAsync<LoginResponse>("/users/login", payload);
            return result;
        }

        public async Task Logout()
        {
            await PostJsonNoResultAsync("/users/logout", new { });
        }

        public async Task<LoginResponse> CheckSession()
        {
            try
            {
                return await GetJsonAsync<LoginResponse>("/users/check/session");
            }
            catch (HttpRequestException ex)
            {
                Debug.WriteLine("CheckSession hiba: " + ex.Message);
                return null;
            }
        }

        public async Task<User> Register(string name, string email, string password, string ajanlo_id = null)
        {
            var payload = new { name, email, password, ajanlo_id };
            return await PostJsonAsync<User>("/users", payload);
        }

        public async Task<List<AjandekDTO>> GetKedvencek(int userId)
        {
            return await GetJsonAsync<List<AjandekDTO>>($"/kedvencek/{userId}");
        }

        public async Task AddKedvenc(int userId, int ajandekId)
        {
            await PostJsonNoResultAsync($"/kedvencek/{userId}", new { ajandek_id = ajandekId });
        }

        public async Task RemoveKedvenc(int userId, int ajandekId)
        {
            var response = await client.DeleteAsync($"/kedvencek/{userId}/{ajandekId}");
            await ReadResponseOrThrow(response);
        }

        public async Task<List<AjandekDTO>> GetElozmenyek(int userId)
        {
            return await GetJsonAsync<List<AjandekDTO>>($"/elozmenyek/{userId}");
        }

        public async Task AddElozmeny(int userId, int ajandekId)
        {
            await PostJsonNoResultAsync($"/elozmenyek/{userId}", new { ajandek_id = ajandekId });
        }

        public async Task SendInvite(string email, int userId)
        {
            var payload = new { email, userId };
            var response = await client.PostAsync("/invite", new StringContent(JsonSerializer.Serialize(payload, jsonOptions), Encoding.UTF8, "application/json"));
            await ReadResponseOrThrow(response);
        }
    }

    public class UploadResponse
    {
        public string message { get; set; }
        public string filename { get; set; }
    }

    public class AjandekDTO
    {
        public int id { get; set; }
        public string nev { get; set; }
        public string leiras { get; set; }
        public int ar { get; set; }
        public string kategoria { get; set; }
        public string image_url { get; set; }
        public string link_url { get; set; }
    }

    public class LoginResponse
    {
        public string username { get; set; }
        public int userId { get; set; }
    }

    public class User
    {
        public int id { get; set; }
        public string name { get; set; }
        public string email { get; set; }
    }
}
